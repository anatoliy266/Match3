{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "d32601d4fcd44766b0e9f7156d3bcfe0",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GetTangle (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -251.99989318847657,
            "y": 199.99998474121095,
            "width": 222.99986267089845,
            "height": 517.9999389648438
        }
    },
    "m_Slots": [
        {
            "m_Id": "ca6de093549243b3b94121e84ef11945"
        },
        {
            "m_Id": "45d1cde361c0425fbea645fbfbbd2718"
        },
        {
            "m_Id": "d149c3a7226e4002bfb8eb93f49c2eb3"
        },
        {
            "m_Id": "ad6e93f7ca324066bcc72eace5c35e33"
        },
        {
            "m_Id": "72401c9eb82c40dba05c8dff01287f61"
        },
        {
            "m_Id": "c98e043725ba472999f7d3cbba5b03ce"
        },
        {
            "m_Id": "57421ca8ddb14a8f900a6fef1bb1073b"
        },
        {
            "m_Id": "8a5e3ca827384a3c91731bbb191dded6"
        },
        {
            "m_Id": "7f8ae23214f94ec19bfef25d0ed08096"
        },
        {
            "m_Id": "2f56657da332409ca5bb022df80fc75d"
        },
        {
            "m_Id": "2eae61aa072149d0a84071b5f2916be7"
        },
        {
            "m_Id": "8ff7385fea764d24bd9d93a2201629d4"
        },
        {
            "m_Id": "5445d62f7da4480988093d460693bce1"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetTangle",
    "m_FunctionSource": "a21a8757da5a64d45b3f67ceed06f5b3",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Out = float3(0.0, 0.0, 0.0);\nAlphaOut = 0.0;\nfloat currentMaxDepth = -9999.0;\n\n[loop]\nfor (int i = 0; i < int(Count); i++)\n{\n    float fi = float(i);\n    bool isVertical = (i % 2 == 0);\n    \n    // 1. Случайные сдвиги осей хаоса\n    float shiftX = frac(sin(fi * 45.32) * 43758.54) * 100.0;\n    float shiftY = frac(sin(fi * 89.12) * 23145.12) * 100.0;\n    float2 threadShift = float2(shiftX, shiftY);\n    \n    // Анимация уезда по времени для каждой нити отдельно\n    float individualSpeed = 0.4 + frac(sin(fi * 15.73) * 43758.54) * 0.6;\n    float individualDelay = frac(sin(fi * 74.12) * 23145.12) * 2.0;\n    float individualGrowth = max((Time - individualDelay) * individualSpeed, 0.0);\n\n    float2 movingUV = UV;\n    if (isVertical) { movingUV.y -= individualGrowth; }\n    else { movingUV.x -= individualGrowth; }\n\n    // Проверка: отрисовка только тех частей, которые еще не уехали с экрана\n    float checkCoord = isVertical ? UV.y : UV.x;\n    if (checkCoord >= individualGrowth)\n    {\n        // 2. Двумерный Curl Noise (Вихревой шум)\n        float2 uvScale = movingUV * NoiseScale + threadShift;\n        \n        float2 ipA = floor(uvScale); float2 fpA = frac(uvScale); float2 uA = fpA * fpA * (3.0 - 2.0 * fpA);\n        float n00_A = frac(sin(dot(ipA + float2(0,0), float2(127.1,311.7))) * 43758.5453);\n        float n10_A = frac(sin(dot(ipA + float2(1,0), float2(127.1,311.7))) * 43758.5453);\n        float n01_A = frac(sin(dot(ipA + float2(0,1), float2(127.1,311.7))) * 43758.5453);\n        float n11_A = frac(sin(dot(ipA + float2(1,1), float2(127.1,311.7))) * 43758.5453);\n        float noiseA = lerp(lerp(n00_A, n10_A, uA.x), lerp(n01_A, n11_A, uA.x), uA.y);\n        \n        float2 uvScaleB = uvScale + float2(0.01, 0.01);\n        float2 ipB = floor(uvScaleB); float2 fpB = frac(uvScaleB); float2 uB = fpB * fpB * (3.0 - 2.0 * fpB);\n        float n00_B = frac(sin(dot(ipB + float2(0,0), float2(127.1,311.7))) * 43758.5453);\n        float n10_B = frac(sin(dot(ipB + float2(1,0), float2(127.1,311.7))) * 43758.5453);\n        float n01_B = frac(sin(dot(ipB + float2(0,1), float2(127.1,311.7))) * 43758.5453);\n        float n11_B = frac(sin(dot(ipB + float2(1,1), float2(127.1,311.7))) * 43758.5453);\n        float noiseB = lerp(lerp(n00_B, n10_B, uB.x), lerp(n01_B, n11_B, uB.x), uB.y);\n        \n        float2 curlVector = float2(noiseB - noiseA, noiseA - noiseB) * 50.0;\n        float2 distortedUV = movingUV + curlVector * NoiseStrength * 0.01;\n        \n        // 3. Траектория прямых фигурных линий\n        float baseCoord = isVertical ? distortedUV.y : distortedUV.x;\n        float crossCoord = isVertical ? distortedUV.x : distortedUV.y;\n        float targetPos = 0.05 + (fi / Count) * 0.9;\n        \n        // 4. Координаты текстуры\n        float distanceToLine = crossCoord - targetPos;\n        float texU = distanceToLine * 8.5 + 0.5;\n        float texV = baseCoord * RopeTiling;\n        float2 finalTexUV = float2(texU, texV);\n        \n        // 5. Чтение упакованной маски\n        float4 packedSample = SAMPLE_TEXTURE2D_BIAS(LineTex.tex, LineSampler.samplerstate, finalTexUV, -2.0);\n        \n        float silhouetteMask = step(AlphaClip, packedSample.r);\n        \n        // Защита от перетирания цвета пустым циклом на других итерациях\n        if (silhouetteMask > 0.0)\n        {\n            // 6. Высокочастотный Z-буфер для жесткого плетения\n            float weavePulse = cos(baseCoord * Z_Entangle + fi * 3.14) * 0.4;\n            float depthRandom = frac(sin(fi * 12.54) * 78912.34);\n            float pixelDepth = weavePulse + (curlVector.x - curlVector.y) * 0.1 + (1.0 - abs(distanceToLine * 8.5)) + (depthRandom * 0.2);\n\n            if (pixelDepth > currentMaxDepth)\n            {\n                currentMaxDepth = pixelDepth;\n                \n                // 7. Твоя исходная генерация случайного цвета нити\n                float r = frac(sin(fi * 45.32) * 43758.54);\n                float g = frac(sin(fi * 89.12) * 23145.12);\n                float b = frac(sin(fi * 12.54) * 78912.34);\n                float3 lineColor = float3(r, g, b);\n                \n                // Твои белые прожилки из зеленого канала (рельеф)\n                float internalPattern = packedSample.g;                  \n                float patternContrast = smoothstep(0.1, 0.9, internalPattern) * 0.4;\n                float3 colorWithPattern = lerp(lineColor, lineColor * 0.3, patternContrast);\n                \n                // Объемное затемнение по краям каната\n                float edgeShadow = smoothstep(0.0, 0.5, saturate(1.0 - abs(distanceToLine * 8.5)));\n                \n                Out = colorWithPattern * edgeShadow;\n                AlphaOut = 1.0; \n            }\n        }\n    }\n}"
}

